# Postgres connection (matches docker-compose.yml: `npm run db:up`)
DATABASE_URL="postgresql://reef:reef@localhost:5433/reefworld"

# Which Solana network the Hatchery launches on and the reef shows: "devnet" (default, free test tokens)
# or "mainnet-beta" (real tokens that cost real SOL). Keep devnet for development.
SOLANA_NETWORK="devnet"

# Solana RPC endpoint used by the server. Optional; defaults to the public endpoint for SOLANA_NETWORK.
# For mainnet use a dedicated provider (Helius, Triton, QuickNode...): the public endpoint is heavily rate-limited.
SOLANA_RPC_URL=""

# Public URL of this site. Used in the sign-in message and for self-hosted token metadata.
SITE_URL="http://localhost:3000"

# Pinata JWT (https://app.pinata.cloud -> API Keys). Optional, recommended for mainnet: token images and
# metadata are pinned to IPFS so they stay reachable even if this site goes away. Without it, this site
# serves the metadata itself, which on mainnet requires a public https SITE_URL.
PINATA_JWT=""
# Optional IPFS gateway for the stored URLs (default https://ipfs.io/ipfs).
PINATA_GATEWAY_URL=""

# CoinGecko Demo API key (free), used only for the SOL/USD price. Optional.
# Get one at https://www.coingecko.com/en/api/pricing -> "Demo" plan -> create a key in the developer dashboard.
# Without it the worker polls the price less often and logs a warning.
COINGECKO_API_KEY=""

# Set to 1 to close the Hatchery (e.g. during maintenance).
HATCHERY_DISABLED=""

# Protects /api/cron (Vercel Cron sends it automatically as a Bearer token). Any long random string.
CRON_SECRET=""
